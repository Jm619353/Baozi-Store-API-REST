# Identificação do Projeto
spring.application.name=api

# CONFIGURAÇÕES DE CONEXÃO COM O BANCO DE DADOS (MySQL)

# String de conexão JDBC. 
# NOME_DO_SEU_BANCO: nome do Schema no MySQL.
# useSSL=false: Desativa conexões seguras para ambiente de desenvolvimento local.
# serverTimezone=UTC: Garante a sincronia de horários entre a aplicação e o banco.

# Dados da Conexao (Preencha com seus dados locais)
spring.datasource.url=jdbc:mysql://localhost:3306/NOME_DO_SEU_BANCO?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true&createDatabaseIfNotExist=true

# Credenciais de acesso ao serviço de banco de dados
spring.datasource.username=SEU_USUARIO
spring.datasource.password=SUA_SENHA

# ESTRATÉGIA DE PERSISTÊNCIA E ORM (HIBERNATE)


# DDL-AUTO: Define como o Hibernate deve gerenciar o esquema do banco.
# 'update': Altera o banco de dados para refletir mudanças nas classes @Entity 
# sem apagar os dados existentes. Ideal para fase de desenvolvimento.
spring.jpa.hibernate.ddl-auto=update

# LOGGING E DEBUG:
# Habilita a exibição dos comandos SQL gerados pelo Hibernate no console.
spring.jpa.show-sql=true

# Formata o SQL exibido para facilitar a leitura e depuração (Debug).
spring.jpa.properties.hibernate.format_sql=true
